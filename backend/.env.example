PORT=3000
NODE_ENV=development
# Firebase: file service account (Project settings > Service accounts > Generate new private key)
FIREBASE_KEY_FILE=serviceAccountKey.json
# Web API key (Project settings > General > Web API key, hoặc "current_key" trong google-services.json)
FIREBASE_API_KEY=dan_web_api_key_cua_project_vao_day
JWT_SECRET=thay_bang_chuoi_bi_mat_dai
JWT_EXPIRES_IN=7d

# Gửi OTP quên mật khẩu qua Gmail (tạo App Password tại https://myaccount.google.com/apppasswords)
# Để trống => chế độ dev: OTP được in ra console và trả về trong response (devOtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Chatbot AI (API chuẩn OpenAI, mặc định dùng OmniRoute chạy trên máy)
AI_BASE_URL=http://localhost:20128/v1
AI_MODEL=antigravity/gemini-3.5-flash-lite
# Dán API key của OmniRoute vào đây (Dashboard OmniRoute > API Keys)
AI_API_KEY=
